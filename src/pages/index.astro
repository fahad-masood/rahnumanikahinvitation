---
import '../styles/global.css';
import '../styles/names.css';
import Arch from '../components/Arch.astro';
import Botanical from '../components/Botanical.astro';
import CornerFloral from '../components/CornerFloral.astro';
import Ornament from '../components/Ornament.astro';
import Icon from '../components/Icon.astro';
import Calendar from '../components/Calendar.astro';
import InvitationMusic from '../components/InvitationMusic.astro';
import { event } from '../data/event';

const title = `${event.couple} · The Nikah Ceremony`;
const description = 'With gratitude and joy, you are warmly invited to the Nikah of Rahnuma Zarrin & Fahad Masood. Thursday, 12 November 2026 · 6:00 PM IST · Aman Park, New Delhi, India.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/social-preview.png', Astro.site).href : '/social-preview.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#4f181d" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Nikah Ceremony. Rahnuma & Fahad. 12 November 2026. Maroon and green floral invitation." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The Nikah Ceremony — Rahnuma & Fahad — 12 November 2026" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/great-vibes-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-arabic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#invitation">Skip to invitation</a>
    <div class="page-frame" aria-hidden="true"></div>
    <header class="masthead">
      <a class="monogram" href="#home" aria-label="R & F — Rahnuma and Fahad, return to the invitation">R<span>&</span>F<span class="monogram-flower" aria-hidden="true">✧</span></a>
      <p class="masthead-message">A CELEBRATION OF FAITH & LOVE</p>
      <a class="masthead-date" href="#celebration">12.11.2026 <Icon name="arrow" /></a>
    </header>
    <main>
      <section id="home" class="hero" aria-labelledby="couple-names">
        <CornerFloral />
        <Arch />
        <div class="hero-content">
          <p class="bismillah" lang="ar" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          <p class="bismillah-translation">In the Name of Allah, the Most Gracious, the Most Merciful.</p>
          <p class="eyebrow hero-blessing">BY THE GRACE AND INFINITE BLESSINGS OF ALLAH (SWT)</p>
          <p class="hero-occasion">The Nikah Ceremony</p>
          <h1 id="couple-names" class="couple-names"><span>{event.bride}</span><span class="ampersand">&</span><span>{event.groom}</span></h1>
          <Ornament class="hero-ornament" />
          <p class="hero-date"><time datetime="2026-11-12">12 November 2026</time></p>
          <p class="hero-place">{event.venue} <span aria-hidden="true">·</span> {event.city} <span aria-hidden="true">·</span> {event.timeLabel}</p>
        </div>
        <a class="hero-scroll" href="#invitation"><span>WITH LOVE, YOU ARE INVITED</span><Icon name="down" /></a>
        <span class="hero-side-note" aria-hidden="true">TWO HEARTS. ONE BEAUTIFUL BEGINNING.</span>
      </section>

      <section id="invitation" class="invitation section-dark" aria-labelledby="invitation-title">
        <div class="section-inner invitation-inner">
          <Ornament />
          <p class="eyebrow">AN INVITATION FROM OUR HEARTS</p>
          <h2 id="invitation-title">With gratitude.<br /><em>With joy. With you.</em></h2>
          <img class="couple-illustration" src="/illustrations/couple.webp" width="640" height="686" loading="lazy" decoding="async" alt="An illustrated veiled bride with a flowing burgundy train beside her groom, seen from behind." />
          <p class="invitation-intro">With hearts filled with gratitude and joy,</p>
          <p class="host-name">Mrs. Shamshad Begum <span>and family</span></p>
          <p class="invitation-copy">request the honour of your presence and heartfelt duas<br class="desktop-break" /> on the blessed occasion of the <strong>Nikah Ceremony</strong> of</p>
          <p class="invitation-couple">Rahnuma Zarrin <span>&</span> Fahad Masood</p>
          <div class="family-details">
            <p><span class="family-label">THE BRIDE</span>Daughter of<br /><strong>Mrs. Shamshad Begum</strong></p>
            <Ornament class="family-ornament" />
            <p><span class="family-label">THE GROOM</span>Son of<br /><strong>Mr. Masood Alam<br />and Mrs Rubeena Shamim</strong></p>
          </div>
          <p class="invitation-outro">Your gracious presence and sincere duas will make<br class="desktop-break" /> this blessed occasion even more special.</p>
        </div>
      </section>

      <section class="verse-section" aria-label="A blessing for the couple">
        <span class="verse-mark" aria-hidden="true">“</span>
        <blockquote>
          <p>And He placed between you<br class="desktop-break" /> <em>affection and mercy.</em></p>
          <footer>An excerpt from the translation of Surah Ar-Rum (30:21)</footer>
        </blockquote>
        <Ornament />
        <p class="spiritual-message">Two souls united by the will of Allah, beginning a beautiful journey<br class="desktop-break" /> of faith, companionship, and love.</p>
      </section>

      <section id="celebration" class="celebration" aria-labelledby="celebration-title">
        <div class="section-inner">
          <p class="eyebrow">A DAY TO HOLD CLOSE</p>
          <h2 id="celebration-title">Save the <em>date</em></h2>
          <p class="inshallah">In Shaa Allah</p>
          <Calendar />
          <div class="venue-heading"><Icon name="pin" /><p>Aman Park <span>New Delhi, India</span></p></div>
          <div class="actions">
            <a class="button button-maroon" href={event.mapsUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" />Get Directions<Icon name="arrow" /></a>
            <a class="button button-outline" href={event.calendarPath} download="Rahnuma-and-Fahad-Nikah.ics"><Icon name="calendar" />Add to Calendar</a>
          </div>
        </div>
      </section>

      <section class="venue-section" aria-labelledby="venue-title">
        <div class="venue-art" aria-hidden="true">
          <div class="venue-art-border"></div>
          <svg viewBox="0 0 640 400" fill="none" class="architecture" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round">
              <path d="M33 347h574M59 339h522M96 332h448M119 325V202h402v123M138 316V218h364v98M220 325V204h200v121M231 202v-25h178v25M241 176c0-44 35-59 79-91 44 32 79 47 79 91M251 174c0-36 33-53 69-76 36 23 69 40 69 76M320 85V61m-5 1h10m-5-10v9M212 204h216M214 211h212"/>
              <path d="M281 325v-76c0-20 20-28 39-47 19 19 39 27 39 47v76M290 325v-73c0-16 16-24 30-37 14 13 30 21 30 37v73M156 324v-65c0-15 13-23 24-34 11 11 24 19 24 34v65m232 0v-65c0-15 13-23 24-34 11 11 24 19 24 34v65M119 202h98m206 0h98M133 201v-16h65v16m244 0v-16h65v16M144 184c0-16 10-26 21-36 11 10 22 20 22 36m266 0c0-16 10-26 22-36 11 10 21 20 21 36M165 147v-15m310 15v-15M119 201v-54h14v38m374 0v-38h14v54M119 147l7-12 7 12m374 0 7-12 7 12M248 228v19m0 13v19m144-51v19m0 13v19M97 325v-37m446 37v-37"/>
              <path d="M63 324c-8-50 10-84 33-110-11 42-10 75 1 111M78 274c-27-2-40-14-44-35 27 3 39 16 44 35Zm4-18c-7-25-1-44 15-62 9 25 2 44-15 62Zm-3 39c-27 4-44-5-53-22 26-2 44 5 53 22Zm8-18c22-10 31-27 27-47-22 12-30 29-27 47Zm2 28c24-3 37-16 39-36-24 5-36 17-39 36ZM577 324c8-50-10-84-33-110 11 42 10 75-1 111m19-51c27-2 40-14 44-35-27 3-39 16-44 35Zm-4-18c7-25 1-44-15-62-9 25-2 44 15 62Zm3 39c27 4 44-5 53-22-26-2-44 5-53 22Zm-8-18c-22-10-31-27-27-47 22 12 30 29 27 47Zm-2 28c-24-3-37-16-39-36 24 5 36 17 39 36Z"/>
              <path d="m320 26 4 9 10 1-8 6 2 10-8-5-8 5 2-10-8-6 10-1 4-9Z"/>
            </g>
          </svg>
          <span class="art-caption">INSPIRED BY THE ARCHITECTURE OF DELHI</span>
        </div>
        <div class="venue-copy">
          <p class="eyebrow">A PLACE FOR BEAUTIFUL MEMORIES</p>
          <h2 id="venue-title">Meet us at<br /><em>Aman Park.</em></h2>
          <p class="venue-address">New Delhi, India</p>
          <p>Join us for an evening of togetherness,<br class="desktop-break" /> blessings, and a beautiful new beginning.</p>
          <a class="text-link" href={event.mapsUrl} target="_blank" rel="noopener noreferrer">Find your way to the celebration<Icon name="arrow" /></a>
        </div>
      </section>

      <section class="closing section-dark" aria-labelledby="closing-title">
        <Botanical class="closing-botanical closing-botanical-left" />
        <Botanical class="closing-botanical closing-botanical-right" />
        <div class="closing-inner">
          <Ornament />
          <p class="eyebrow">WITH YOUR PRESENCE & YOUR DUAS</p>
          <h2 id="closing-title">Some moments are a blessing.<br /><em>Sharing them with you is another.</em></h2>
          <p>May Allah bless this union with love, mercy, understanding,<br class="desktop-break" /> and endless barakah. Ameen.</p>
          <p class="warm-regards">With warm regards</p>
          <p class="closing-family">Mrs. Shamshad Begum & Family</p>
          <a class="button button-light share-invitation" data-whatsapp-share hidden target="_blank" rel="noopener noreferrer"><Icon name="share" />Share invitation on WhatsApp<Icon name="arrow" /></a>
          <p class="sharing-note" data-share-note hidden>With love, for our invited family and friends.</p>
        </div>
      </section>
    </main>
    <footer class="page-footer"><a class="footer-monogram" href="#home" aria-label="R & F — Rahnuma and Fahad, back to top">R <em>&</em> F</a><p>12 NOVEMBER 2026 <span aria-hidden="true">✧</span> WITH FAITH, WITH LOVE</p><a href="#home" class="back-top">BACK TO TOP <span aria-hidden="true">↑</span></a></footer>
    <InvitationMusic />
    <script>
      import { whatsappMessage } from '../data/event';
      const shareLink = document.querySelector<HTMLAnchorElement>('[data-whatsapp-share]');
      if (shareLink) {
        const currentUrl = new URL(window.location.href);
        currentUrl.hash = '';
        shareLink.href = `https://wa.me/?text=${encodeURIComponent(whatsappMessage(currentUrl.href))}`;
        shareLink.hidden = false;
        document.querySelector<HTMLElement>('[data-share-note]')?.removeAttribute('hidden');
      }
    </script>
  </body>
</html>
