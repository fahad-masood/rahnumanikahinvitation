---
interface Props { name: 'arrow' | 'pin' | 'calendar' | 'share' | 'down'; }
const { name } = Astro.props;
---
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h16m-6-6 6 6-6 6"/>}
  {name === 'down' && <path d="M12 3v18m-6-6 6 6 6-6"/>}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'calendar' && <><rect x="4" y="5" width="16" height="16" rx="1"/><path d="M8 3v5m8-5v5M4 11h16m-12 4h3m2 0h3m-8 3h3"/></>}
  {name === 'share' && <><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4m-6.8 7 6.8 4"/></>}
</svg>
